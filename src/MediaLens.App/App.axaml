<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MediaLens.App.App"
             Name="MediaLens"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE1E6" />
                    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5B6472" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#ECEEF2" />
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E0E8FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111317" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181B21" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#181B21" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#2A2F38" />
                    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9AA3B0" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#1E2229" />
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#22305A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="SystemAccentColor">#FF3B82F6</Color>
            <Color x:Key="SystemAccentColorLight1">#FF60A5FA</Color>
            <Color x:Key="SystemAccentColorLight2">#FF93C5FD</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBFDBFE</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2563EB</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1E40AF</Color>
            <SolidColorBrush x:Key="SelectionBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="BucketBadgeBrush" Color="#FFF59E0B" />

            <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <mi:MaterialIconStyles />
        <StyleInclude Source="/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
