<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
        xmlns:c="clr-namespace:MediaLens.Cloud;assembly=MediaLens.Core"
        xmlns:l="clr-namespace:MediaLens.Library;assembly=MediaLens.Core"
        x:Class="MediaLens.App.Views.CloudWindow"
        x:DataType="vm:CloudViewModel"
        Title="Cloud and backup"
        Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}">Stop</Button>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Mirror your folders into a cloud. With a password, files and their names are encrypted on this computer before upload: the provider stores only noise. Without the password nobody can read the backup, not even you." />
        <TextBlock DockPanel.Dock="Top" Foreground="#F97066" TextWrapping="Wrap" Margin="0,0,0,12" IsVisible="{Binding RcloneMissing}"
                   Text="rclone was not found. The installer brings it along; for a development build install rclone (rclone.org)." />

        <Grid ColumnDefinitions="*,16,*">
            <!-- Clouds -->
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <TextBlock Text="CLOUDS" Classes="heading" Margin="0" />
                    <ListBox ItemsSource="{Binding Clouds}" SelectedItem="{Binding SelectedCloud}" MaxHeight="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="c:CloudInfo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="CloudOutline" />
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding KindTitle}" Classes="muted" />
                                    <mi:MaterialIcon Kind="Lock" IsVisible="{Binding Encrypted}" ToolTip.Tip="Encrypted" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Folders in the selected cloud" Classes="muted small" />
                    <ListBox ItemsSource="{Binding CloudFolders}" SelectedItem="{Binding SelectedFolder}" MaxHeight="130" />
                    <WrapPanel>
                        <Button Command="{Binding AddAsSourceCommand}" Margin="0,0,6,6" ToolTip.Tip="Browse and search the folder without keeping a local copy">Browse as a source</Button>
                        <Button Click="OnRestore" Margin="0,0,6,6" ToolTip.Tip="Download the folder back to this computer">Restore to a folder...</Button>
                        <Button Command="{Binding ImportIndexCommand}" Margin="0,0,6,6" ToolTip.Tip="Names, people and buckets from the cloud's backup of the index">Import names</Button>
                        <Button Command="{Binding RemoveCloudCommand}" Margin="0,0,6,6">Remove cloud</Button>
                    </WrapPanel>

                    <TextBlock Text="ADD A CLOUD" Classes="heading" Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Stretch" />
                    <TextBox Text="{Binding Name}" PlaceholderText="Name (e.g. Family backup)" />
                    <StackPanel Spacing="6" IsVisible="{Binding IsS3}">
                        <TextBox Text="{Binding Bucket}" PlaceholderText="Bucket" />
                        <TextBox Text="{Binding AccessKey}" PlaceholderText="Access key" />
                        <TextBox Text="{Binding SecretKey}" PlaceholderText="Secret key" PasswordChar="*" />
                        <TextBox Text="{Binding Provider}" PlaceholderText="Provider (AWS, Wasabi, Minio, Other...)" />
                        <TextBox Text="{Binding Region}" PlaceholderText="Region (e.g. eu-central-1)" />
                        <TextBox Text="{Binding Endpoint}" PlaceholderText="Endpoint (only for non-Amazon storage)" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsFolder}">
                        <TextBox Text="{Binding Folder}" PlaceholderText="Folder" />
                        <Button Grid.Column="1" Click="OnPickFolder" Margin="6,0,0,0">...</Button>
                    </Grid>
                    <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsSignIn}"
                               Text="Add opens your browser to sign in; MediaLens gets access only through rclone on this computer." />
                    <CheckBox IsChecked="{Binding Encrypt}">Encrypt (recommended)</CheckBox>
                    <StackPanel Spacing="6" IsVisible="{Binding Encrypt}">
                        <TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="Password (at least 8 characters)" />
                        <TextBox Text="{Binding PasswordAgain}" PasswordChar="*" PlaceholderText="Password again" />
                        <TextBlock Classes="muted small" TextWrapping="Wrap"
                                   Text="Write the password down somewhere safe. Another computer reads the backup with MediaLens (or plain rclone) and this password." />
                    </StackPanel>
                    <Button Classes="accent" Command="{Binding AddCloudCommand}" IsEnabled="{Binding !Busy}">Add</Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Mirrors -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="10">
                    <TextBlock Text="MIRRORS" Classes="heading" Margin="0" />
                    <ListBox ItemsSource="{Binding Mirrors}" SelectedItem="{Binding SelectedMirror}" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="c:MirrorInfo">
                                <StackPanel Spacing="2">
                                    <TextBlock>
                                        <Run Text="{Binding SourceName}" />
                                        <Run Text=" to " />
                                        <Run Text="{Binding CloudName}" />
                                    </TextBlock>
                                    <TextBlock Classes="muted small" Text="{Binding LastResult, FallbackValue=never run, TargetNullValue=not run yet}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                        <Button Command="{Binding RunMirrorCommand}" Margin="0,0,6,6" ToolTip.Tip="The selected mirror, or all when none is selected">Run now</Button>
                        <Button Command="{Binding RemoveMirrorCommand}" Margin="0,0,6,6">Stop mirroring</Button>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Mirror every" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding IntervalHours}" Minimum="1" Maximum="168" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="hours" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted small" TextWrapping="Wrap"
                               Text="Only new and changed files are uploaded, and nothing is ever deleted in the cloud: a photo deleted here by mistake stays in the backup. The index (names, people, buckets) is backed up encrypted with every run." />

                    <TextBlock Text="NEW MIRROR" Classes="heading" Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding MirrorSource}" PlaceholderText="Source folder" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="l:Source">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding Clouds}" SelectedItem="{Binding MirrorCloud}" PlaceholderText="Cloud" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="c:CloudInfo">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="accent" Command="{Binding AddMirrorCommand}">Mirror</Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
