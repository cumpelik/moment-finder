<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
        xmlns:c="clr-namespace:MediaLens.Cloud;assembly=MediaLens.Core"
        x:Class="MediaLens.App.Views.LibraryBackupWindow"
        x:DataType="vm:CloudViewModel"
        Title="Library backup"
        Width="640" SizeToContent="Height" MinWidth="520" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The library is what MediaLens knows about your photos and videos: settings, sources, names and people, buckets, search data, thumbnails and your clouds. Choose a cloud to keep it in (it can be another one than your photos go to), and one recovery string brings it back on any computer." />
        <TextBlock Foreground="#F97066" TextWrapping="Wrap" IsVisible="{Binding RcloneMissing}"
                   Text="rclone was not found. The installer brings it along; for a development build install rclone (rclone.org)." />

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="KEEP THE LIBRARY IN" Classes="heading" Margin="0" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <ComboBox ItemsSource="{Binding Clouds}" SelectedItem="{Binding BackupCloud}" HorizontalAlignment="Stretch"
                              PlaceholderText="Choose a cloud (the library is not backed up now)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="c:CloudInfo">
                                <TextBlock>
                                    <Run Text="{Binding Name}" />
                                    <Run Text="{Binding KindTitle}" Foreground="Gray" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Click="OnAddCloud" Margin="6,0,0,0" ToolTip.Tip="Opens Backup, where clouds are added">Add a cloud...</Button>
                    <Button Grid.Column="2" Command="{Binding StopBackupCommand}" Margin="6,0,0,0" IsVisible="{Binding HasBackupCloud}"
                            ToolTip.Tip="The library is no longer backed up; what is in the cloud stays there">Stop</Button>
                </Grid>
                <TextBlock Text="{Binding BackupSummary}" TextWrapping="Wrap" />
                <WrapPanel IsVisible="{Binding HasBackupCloud}">
                    <Button Command="{Binding BackUpNowCommand}" Margin="0,0,6,6">Back up now</Button>
                    <Button Classes="accent" Command="{Binding ShowRecoveryCommand}" Margin="0,0,6,6"
                            ToolTip.Tip="One string that brings the whole library back on any computer">Show my recovery string</Button>
                </WrapPanel>
                <StackPanel Spacing="6" IsVisible="{Binding RecoveryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBox Text="{Binding RecoveryText}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="84" FontFamily="monospace" FontSize="11" />
                    <WrapPanel>
                        <Button Click="OnCopyRecovery" Margin="0,0,6,6">Copy</Button>
                        <Button Click="OnSaveRecovery" Margin="0,0,6,6">Save to a file...</Button>
                    </WrapPanel>
                    <TextBlock Foreground="#F59E0B" TextWrapping="Wrap" FontSize="12"
                               Text="Keep it where you keep passwords, not on this computer only. With it a new computer has your library back; without it the backup cannot be read. Anybody who has it can read everything." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="BRING A LIBRARY BACK (NEW OR SECOND COMPUTER)" Classes="heading" Margin="0" />
                <TextBox Text="{Binding RestoreText}" PlaceholderText="Paste your recovery string here" TextWrapping="Wrap" MaxHeight="64"
                         FontFamily="monospace" FontSize="11" />
                <Button Command="{Binding FindBackupsCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left">Find my library</Button>
                <StackPanel Spacing="8" IsVisible="{Binding HasFoundBackups}">
                    <ListBox ItemsSource="{Binding FoundBackups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="90">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="c:LibraryRestore+Found">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <CheckBox IsChecked="{Binding RestoreThumbnails}"
                              ToolTip.Tip="Without them the library is here sooner, and the thumbnails are made again from the originals">With thumbnails</CheckBox>
                    <TextBlock Classes="muted small" TextWrapping="Wrap"
                               Text="It replaces the library on this computer (kept beside it as library.before-restore.db). Folders that are not on this computer are browsed from the cloud; nothing is downloaded until you open it." />
                    <Button Classes="accent" Command="{Binding RestoreLibraryCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left">Bring this library back</Button>
                </StackPanel>
                <Button Classes="accent" Command="{Binding RestartCommand}" IsVisible="{Binding RestartNeeded}" HorizontalAlignment="Left">Restart MediaLens to open it</Button>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}">Stop</Button>
            </Grid>
        </Border>
    </StackPanel>
</Window>
