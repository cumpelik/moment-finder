<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
             x:Class="MediaLens.App.Views.PlayerView"
             x:DataType="vm:PlayerViewModel">
    <UserControl.Styles>
        <!-- A click on a control must not take the keyboard: Space stays play / pause, not that button -->
        <Style Selector="Button, ToggleButton">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- Not the normal speed: visible at a glance -->
        <Style Selector="Button.active">
            <Setter Property="Foreground" Value="#F59E0B" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" Background="Black">
        <!-- The picture and the people boxes share one coordinate space (pixels of the picture); the Viewbox fits it to the screen. -->
        <Viewbox Stretch="Uniform">
            <Panel Width="{Binding ContentWidth}" Height="{Binding ContentHeight}">
                <Image x:Name="PhotoImage" Source="{Binding Photo}" Stretch="Fill" IsVisible="{Binding !IsVideo}" />
                <Image x:Name="VideoImage" Stretch="Fill" IsVisible="{Binding VideoReady}" />
                <Canvas x:Name="PeopleLayer" IsVisible="{Binding ShowPeople}" />
            </Panel>
        </Viewbox>
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,8" CornerRadius="6"
                Background="#CC000000" IsVisible="{Binding ShowPeople}" IsHitTestVisible="False">
            <TextBlock Text="{Binding PeopleHint}" Foreground="White" FontSize="15" />
        </Border>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18,12" CornerRadius="8" MaxWidth="560"
                Background="#CC000000" IsHitTestVisible="False"
                IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Notice}" Foreground="White" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,14" CornerRadius="8" Background="#CC000000"
                IsHitTestVisible="False" IsVisible="{Binding IsLoading}">
            <StackPanel Spacing="10" Width="160">
                <TextBlock Text="Loading..." Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="#DDDDDD" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />

        <Border x:Name="Overlay" Classes="overlay" VerticalAlignment="Bottom">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVideo}">
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="{Binding VideoLength}" Value="{Binding VideoPosition, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding VideoTimeText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontFeatures="tnum" />
                </Grid>
                <!-- Title on the left, all controls in one row on the right: fits the panel as well as the full screen -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MomentText}" FontSize="12" Foreground="#F59E0B"
                                   IsVisible="{Binding MomentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Command="{Binding PreviousCommand}" ToolTip.Tip="Previous (Left)">
                            <mi:MaterialIcon Kind="SkipPrevious" />
                        </Button>
                        <Button Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play / pause; with photos a slideshow (Space)">
                            <Panel>
                                <mi:MaterialIcon Kind="Play" IsVisible="{Binding !IsRunning}" />
                                <mi:MaterialIcon Kind="Pause" IsVisible="{Binding IsRunning}" />
                            </Panel>
                        </Button>
                        <Button Command="{Binding NextCommand}" ToolTip.Tip="Next (Right)">
                            <mi:MaterialIcon Kind="SkipNext" />
                        </Button>
                        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Opacity="0.75" Margin="6,0,12,0" />
                        <ComboBox ItemsSource="{Binding MomentChoices}" SelectedItem="{Binding MomentChoice}" IsVisible="{Binding ShowMomentChoices}"
                                  VerticalAlignment="Center" MinWidth="150" Margin="0,0,4,0" Focusable="False"
                                  ToolTip.Tip="What the videos play: whole, or only the moments of someone" />
                        <!-- Looking at a technique: frame by frame, slow motion, loop -->
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding IsVideo}" Margin="0,0,6,0">
                            <Button Command="{Binding NextFrameCommand}" IsVisible="{Binding !IsRunning}" ToolTip.Tip="One frame further (.)">
                                <mi:MaterialIcon Kind="StepForward" />
                            </Button>
                            <Button Classes.active="{Binding IsSlowOrFast}" MinWidth="46" ToolTip.Tip="Speed: slow motion ([ slower, ] faster)">
                                <TextBlock Text="{Binding RateText}" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="0.1×" Command="{Binding SetRateCommand}" CommandParameter="0.1" />
                                        <MenuItem Header="0.25×" Command="{Binding SetRateCommand}" CommandParameter="0.25" />
                                        <MenuItem Header="0.5×" Command="{Binding SetRateCommand}" CommandParameter="0.5" />
                                        <MenuItem Header="0.75×" Command="{Binding SetRateCommand}" CommandParameter="0.75" />
                                        <MenuItem Header="1×  normal" Command="{Binding SetRateCommand}" CommandParameter="1" />
                                        <MenuItem Header="1.5×" Command="{Binding SetRateCommand}" CommandParameter="1.5" />
                                        <MenuItem Header="2×" Command="{Binding SetRateCommand}" CommandParameter="2" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <ToggleButton IsChecked="{Binding Loop}" ToolTip.Tip="Loop: the video (or the person's moments) again and again (L)">
                                <mi:MaterialIcon Kind="Repeat" />
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding IsVideo}" Margin="0,0,8,0">
                            <Button Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Sound on / off (Up / Down: volume)" Focusable="False">
                                <Panel>
                                    <mi:MaterialIcon Kind="VolumeHigh" IsVisible="{Binding !IsMuted}" />
                                    <mi:MaterialIcon Kind="VolumeOff" IsVisible="{Binding IsMuted}" />
                                </Panel>
                            </Button>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="70" VerticalAlignment="Center" Focusable="False" />
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding ShowPeople}" ToolTip.Tip="Show the people (I) and say who is who"
                                      Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="AccountBoxOutline" Width="20" Height="20" />
                                <TextBlock Text="Who is who" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Command="{Binding AddToBucketCommand}" ToolTip.Tip="Add to the bucket (B)">
                            <Panel>
                                <mi:MaterialIcon Kind="BasketPlusOutline" IsVisible="{Binding !InBucket}" />
                                <mi:MaterialIcon Kind="Basket" IsVisible="{Binding InBucket}" Foreground="{DynamicResource BucketBadgeBrush}" />
                            </Panel>
                        </Button>
                        <Button x:Name="FullScreenButton" ToolTip.Tip="Full screen (F)">
                            <mi:MaterialIcon Kind="Fullscreen" />
                        </Button>
                        <Button x:Name="CloseButton" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)">
                            <mi:MaterialIcon Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
