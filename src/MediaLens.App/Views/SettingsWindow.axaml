<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
        xmlns:c="clr-namespace:MediaLens.Cloud;assembly=MediaLens.Core"
        x:Class="MediaLens.App.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Settings"
        Width="820" Height="860" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <!-- Viewing -->
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Playing" />
                    <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,Auto" RowSpacing="14">
                        <TextBlock Classes="label" Text="A photo in Play all and Shuffle shows for" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding SlideSeconds}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130" />
                            <TextBlock Classes="label" Text="seconds" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Classes="label" Text="Who is who in a playing video" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <RadioButton GroupName="boxes" IsChecked="{Binding BoxesWhilePlaying}" Content="The boxes follow the people" />
                            <RadioButton GroupName="boxes" IsChecked="{Binding BoxesOnlyPaused}" Content="Boxes only when the video is paused" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="CloudPanel" x:DataType="vm:LibraryCloudViewModel" Spacing="16">
                <!-- The library in a cloud -->
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="The library in a cloud" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="The library is what MediaLens knows about your photos and videos: these settings, the folders, names and people, buckets, search data and thumbnails. Kept in a cloud, it comes back on any computer from one recovery string. It is encrypted on this computer before the upload; the key is in the recovery string." />
                        <TextBlock Foreground="#F97066" TextWrapping="Wrap" IsVisible="{Binding RcloneMissing}"
                                   Text="rclone was not found. The installer brings it along; for a development build install rclone (rclone.org)." />

                        <!-- Not connected: the storage -->
                        <StackPanel Spacing="10" IsVisible="{Binding NotConnected}">
                            <Grid ColumnDefinitions="300,*">
                                <TextBlock Classes="label" Text="Storage" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="300,*" IsVisible="{Binding IsS3}">
                                <TextBlock Classes="label" Text="{Binding Kind.AddressLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Endpoint}" PlaceholderText="{Binding Kind.AddressHint}" />
                            </Grid>
                            <Grid ColumnDefinitions="300,*" IsVisible="{Binding IsS3}">
                                <TextBlock Classes="label" Text="Access key" />
                                <TextBox Grid.Column="1" Text="{Binding AccessKey}" />
                            </Grid>
                            <Grid ColumnDefinitions="300,*" IsVisible="{Binding IsS3}">
                                <TextBlock Classes="label" Text="Secret key" />
                                <TextBox Grid.Column="1" Text="{Binding SecretKey}" PasswordChar="*" />
                            </Grid>
                            <Grid ColumnDefinitions="300,*" IsVisible="{Binding IsS3}">
                                <TextBlock Classes="label" Text="Bucket (made if it is not there)" />
                                <TextBox Grid.Column="1" Text="{Binding Bucket}" />
                            </Grid>
                            <Grid ColumnDefinitions="300,*,Auto" IsVisible="{Binding IsFolder}">
                                <TextBlock Classes="label" Text="Folder" />
                                <TextBox Grid.Column="1" Text="{Binding Folder}" />
                                <Button Grid.Column="2" Click="OnPickFolder" Margin="6,0,0,0">Choose...</Button>
                            </Grid>
                            <Grid ColumnDefinitions="300,*">
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsSignIn}" Text="Connect opens your browser to sign in." />
                                    <Button Classes="accent" Command="{Binding ConnectCommand}" IsEnabled="{Binding !Busy}"
                                            HorizontalAlignment="Left" Padding="16,6">Connect and keep the library there</Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Connected: the state and the way back -->
                        <StackPanel Spacing="10" IsVisible="{Binding Connected}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ConnectedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BackupSummary}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding DisconnectCommand}" IsEnabled="{Binding !Busy}" VerticalAlignment="Top"
                                        ToolTip.Tip="The library stays on this computer only; what is in the cloud is not deleted">Disconnect</Button>
                            </Grid>
                            <WrapPanel>
                                <Button Command="{Binding BackUpNowCommand}" Margin="0,0,8,0">Back up now</Button>
                                <Button Classes="accent" Command="{Binding ShowRecoveryCommand}" IsEnabled="{Binding !Busy}"
                                        ToolTip.Tip="One string that brings the whole library back on any computer">Show my recovery string</Button>
                            </WrapPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding RecoveryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBox Text="{Binding RecoveryText}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" FontFamily="monospace" FontSize="12" />
                                <WrapPanel>
                                    <Button Click="OnCopyRecovery" Margin="0,0,8,0">Copy</Button>
                                    <Button Click="OnSaveRecovery">Save to a file...</Button>
                                </WrapPanel>
                                <TextBlock Foreground="#F59E0B" TextWrapping="Wrap"
                                           Text="Keep it where you keep passwords, not on this computer only. With it a new computer has your library back; without it the backup cannot be read. Anybody who has it can read everything." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bringing a library back -->
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="Bring a library back" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="On a new or second computer: paste the recovery string of your library. It replaces the library on this computer (the old one is kept beside it as library.before-restore.db). Folders that are not on this computer are browsed from the cloud where they were mirrored." />
                        <TextBox Text="{Binding RestoreText}" PlaceholderText="Paste your recovery string here" TextWrapping="Wrap" MaxHeight="100"
                                 FontFamily="monospace" FontSize="12" />
                        <Button Command="{Binding FindBackupsCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left">Find my library</Button>
                        <StackPanel Spacing="10" IsVisible="{Binding HasFoundBackups}">
                            <ListBox ItemsSource="{Binding FoundBackups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="110">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="c:LibraryRestore+Found">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox IsChecked="{Binding RestoreThumbnails}"
                                      ToolTip.Tip="Without them the library is here sooner, and the thumbnails are made again from the originals">With thumbnails</CheckBox>
                            <Button Classes="accent" Command="{Binding RestoreLibraryCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left" Padding="16,6">Bring this library back</Button>
                        </StackPanel>
                        <Button Classes="accent" Command="{Binding RestartCommand}" IsVisible="{Binding RestartNeeded}" HorizontalAlignment="Left" Padding="16,6">Restart MediaLens to open it</Button>
                    </StackPanel>
                </Border>

                <!-- What the cloud part is doing -->
                <Border Classes="card" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}">Stop</Button>
                    </Grid>
                </Border>
            </StackPanel>

            <Button HorizontalAlignment="Right" Click="OnClose" Padding="20,6">Close</Button>
        </StackPanel>
    </ScrollViewer>
</Window>
