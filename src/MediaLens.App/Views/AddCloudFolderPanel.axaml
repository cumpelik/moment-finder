<!-- Shown over the main window (see IOverlayPanel) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
             xmlns:v="clr-namespace:MediaLens.App.Views"
             x:Class="MediaLens.App.Views.AddCloudFolderPanel"
             x:DataType="vm:AddCloudFolderViewModel"
             MaxWidth="780" VerticalAlignment="Center">
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
            CornerRadius="8" BoxShadow="0 8 32 0 #80000000" ClipToBounds="True">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="A folder in the cloud" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,0" />
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" MaxLines="4" />
                <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}" Margin="12,0,0,0">Stop</Button>
                <Button Grid.Column="2" Classes="accent" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" IsVisible="{Binding IsBrowsing}"
                        Padding="16,6" Margin="12,0,0,0">Add this folder</Button>
                <Button Grid.Column="3" Click="OnClose" Padding="20,6" Margin="12,0,0,0">Close</Button>
            </Grid>
        </Border>
        <ScrollViewer>
            <StackPanel Margin="24,24,24,16" Spacing="16">
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="1. Which storage" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Photos and videos you put into a storage yourself (with its own app, or another program) are added to the library from here. They stay there; MediaLens fetches each file when it needs it." />
                        <Grid ColumnDefinitions="300,*" IsVisible="{Binding HasClouds}">
                            <TextBlock VerticalAlignment="Center" Text="Connected storage" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <!-- The form has its own view model: what shows it is bound out here -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsNewStorage}">
                            <v:StorageForm x:Name="NewStorage" />
                            <Button Command="{Binding ConnectCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left">Connect and show its folders</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18" IsVisible="{Binding IsBrowsing}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="2. Which folder" />
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" Margin="0,0,10,0"
                                    ToolTip.Tip="One folder up">
                                <mi:MaterialIcon Kind="ArrowUp" />
                            </Button>
                            <TextBlock Text="{Binding PlaceText}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="260">
                            <Panel>
                                <ListBox x:Name="FolderList" ItemsSource="{Binding Folders}" Background="Transparent" SelectionChanged="OnFolderChosen">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="FolderOutline" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="muted" Margin="12,10" IsVisible="{Binding NoFolders}" Text="No folders inside." />
                            </Panel>
                        </Border>
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding AddText}" />
                        <Grid ColumnDefinitions="300,*" IsVisible="{Binding CanAdd}">
                            <TextBlock VerticalAlignment="Center" Text="Name in the library" />
                            <TextBox Grid.Column="1" Text="{Binding Name}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18" IsVisible="{Binding IsBrowsing}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="3. Read-only?" />
                        <CheckBox IsChecked="{Binding ReadOnly}">Read-only</CheckBox>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Nothing in it can be deleted, moved or added from MediaLens, and it cannot be removed from the library, until read-only is turned off with the password. It guards against mistakes in MediaLens; whoever has the storage's keys can still change the files with other tools." />
                        <StackPanel Spacing="8" IsVisible="{Binding NeedsPassword}">
                            <TextBlock TextWrapping="Wrap" Text="Choose the password (the same for all read-only folders; without it read-only cannot be turned off):" />
                            <TextBox Text="{Binding Password}" PasswordChar="&#x2022;" PlaceholderText="Password" />
                            <TextBox Text="{Binding PasswordAgain}" PasswordChar="&#x2022;" PlaceholderText="The same once more" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</UserControl>
