<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaLens.App.ViewModels"
        xmlns:views="clr-namespace:MediaLens.App.Views"
        x:Class="MediaLens.App.Views.PlayerWindow"
        x:DataType="vm:PlayerViewModel"
        Title="{Binding Title}"
        Background="Black"
        WindowState="FullScreen"
        Width="1280" Height="800">
    <views:PlayerView x:Name="View" />
</Window>
