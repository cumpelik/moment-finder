<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="mi|MaterialIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="Margin" Value="10,14,10,4" />
    </Style>

    <Style Selector="Button.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Sidebar entries: Library, sources, buckets -->
    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
    </Style>

    <!-- Thumbnail tiles -->
    <!-- A thumbnail shows the whole picture, nothing cut off -->
    <Style Selector="Image.thumb">
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- Choices like the years of the date filter; the chosen one is highlighted -->
    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.chip.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- A group of results: under each other in the grid, side by side in the strip under the viewer -->
    <Style Selector="DockPanel.group">
        <Setter Property="Margin" Value="0,4,0,14" />
    </Style>
    <Style Selector="Grid.strip DockPanel.group">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- One of a few buttons of which one is on (where the viewer shows) -->
    <Style Selector="Button.segment">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.segment.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- A toolbar button whose filter is on -->
    <Style Selector="Button.toolbar.active">
        <Setter Property="Foreground" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <!-- The full screen button appears in the corner of the tile under the mouse; a click on the picture selects it -->
    <Style Selector="Button.tileplay">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tileplay:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#CC000000" />
    </Style>
    <Style Selector="Border.tile:pointerover Button.tileplay">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tile.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="#B0000000" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="5" />
    </Style>
    <!-- A 360 video: green plays right away, orange is being prepared now -->
    <Style Selector="Border.badge.ready">
        <Setter Property="Background" Value="#E0059669" />
    </Style>
    <Style Selector="Border.badge.making">
        <Setter Property="Background" Value="#E0D97706" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Player overlay -->
    <Style Selector="Border.overlay">
        <Setter Property="Background" Value="#C0000000" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Border.overlay TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.overlay mi|MaterialIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.overlay Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.overlay Button mi|MaterialIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>
    <!-- A button that cannot be used now (one frame further while playing): faded, no grey patch -->
    <Style Selector="Border.overlay Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.overlay Button:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Previous / play / next: large, apart from the tools -->
    <Style Selector="Border.overlay Button.transport mi|MaterialIcon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>
    <Style Selector="Border.overlay Button.transport.play">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.overlay Button.transport.play mi|MaterialIcon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
    </Style>
</Styles>
