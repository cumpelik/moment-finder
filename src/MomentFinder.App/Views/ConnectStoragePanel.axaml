<!-- Shown over the main window (see IOverlayPanel) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MomentFinder.App.ViewModels"
             xmlns:v="clr-namespace:MomentFinder.App.Views"
             x:Class="MomentFinder.App.Views.ConnectStoragePanel"
             x:DataType="vm:ConnectStorageViewModel"
             MaxWidth="780" VerticalAlignment="Center">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
            CornerRadius="8" BoxShadow="0 8 32 0 #80000000" ClipToBounds="True">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Another storage to copy from" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,0" />
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" MaxLines="4" />
                <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}" Margin="12,0,0,0">Stop</Button>
                <Button Grid.Column="2" Classes="accent" Command="{Binding ConnectCommand}" IsEnabled="{Binding NotBusy}" Padding="16,6" Margin="12,0,0,0">Connect</Button>
                <Button Grid.Column="3" Click="OnClose" Padding="20,6" Margin="12,0,0,0">Cancel</Button>
            </Grid>
        </Border>
        <ScrollViewer>
            <StackPanel Margin="24,20,24,16" Spacing="12">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Photos and videos that are in another storage (another bucket, a OneDrive, a Google Drive) can be copied from there into a folder of the library. Connect it here; then its folders show in the browser, to be dragged like the folders of this computer. Nothing in that storage changes." />
                <Border Classes="card" Padding="18">
                    <v:StorageForm x:Name="NewStorage" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</UserControl>
