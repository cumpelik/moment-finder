<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="clr-namespace:MomentFinder.App.ViewModels"
        xmlns:b="clr-namespace:MomentFinder.Buckets;assembly=MomentFinder.Core"
        xmlns:views="clr-namespace:MomentFinder.App.Views"
        x:Class="MomentFinder.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MomentFinder"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Styles>
        <!-- A clicked button or choice must not keep the keyboard: Space, arrows and Enter belong to the photos -->
        <Style Selector="Button, ToggleButton, ComboBox">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- A group's title in the grid; a long one is cut, the whole is in its tooltip -->
        <DataTemplate x:Key="GroupTitleTemplate" DataType="vm:TileGroup">
            <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" Margin="2,0,0,0">
                <Run Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <Run Text="{Binding Count, StringFormat='   {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TileTemplate" DataType="vm:TileViewModel">
            <Border Classes="tile" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding ToolTip}">
                <Grid>
                    <Image Classes="thumb" Source="{Binding Thumb}" />
                    <Button Classes="tileplay" Click="OnTilePlay" ToolTip.Tip="Full screen (or double click the picture)">
                        <mi:MaterialIcon Kind="Fullscreen" Width="18" Height="18" Foreground="White" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <!-- In the cloud and on this computer already: opens at once -->
                        <Border Classes="badge" IsVisible="{Binding Downloaded}"
                                ToolTip.Tip="Downloaded from the cloud: opens at once">
                            <mi:MaterialIcon Kind="CloudCheckOutline" Width="14" Height="14" Foreground="White" />
                        </Border>
                        <Border Classes="badge" Classes.ready="{Binding Ready360}" Classes.making="{Binding Making360}"
                                IsVisible="{Binding Is360}" ToolTip.Tip="{Binding Tip360}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <mi:MaterialIcon Kind="Rotate360" Width="13" Height="13" Foreground="White" />
                                <TextBlock Text="360" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Classes="badge" IsVisible="{Binding IsVideo}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <mi:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="White" />
                            <TextBlock Text="{Binding DurationText}" />
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding InBucket}" Background="{DynamicResource BucketBadgeBrush}"
                            CornerRadius="11" Width="22" Height="22" Margin="6"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="In the bucket">
                        <mi:MaterialIcon Kind="Basket" Width="13" Height="13" Foreground="Black" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Panel>
    <DockPanel>
        <!-- Status bar: background work and the AI model -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="icon" Command="{Binding TogglePauseCommand}"
                        ToolTip.Tip="Pause / continue all background work: reading the folders, the analysis and the backups to the cloud">
                    <Panel>
                        <mi:MaterialIcon Kind="Pause" IsVisible="{Binding !IndexerPaused}" />
                        <mi:MaterialIcon Kind="Play" IsVisible="{Binding IndexerPaused}" />
                    </Panel>
                </Button>
                <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding IndexerText}" VerticalAlignment="Center" Margin="4,0,10,0" />
                <ProgressBar Grid.Column="2" Width="160" Value="{Binding IndexerProgress}" IsVisible="{Binding IndexerBusy}"
                             VerticalAlignment="Center" />
                <DockPanel Grid.Column="3" Margin="10,0">
                    <!-- What the user asked to be done in the cloud: always in sight while there is any -->
                    <Button DockPanel.Dock="Left" Classes="icon" Click="OnShowCloudJobs" IsVisible="{Binding CloudJobs.HasJobs}" MaxWidth="720"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip.Tip="Uploads and changes in the cloud: how far they are, and what did not go. Click for the list.">
                        <DockPanel>
                            <mi:MaterialIcon DockPanel.Dock="Left" Kind="CloudUploadOutline" Margin="0,0,6,0" IsVisible="{Binding !CloudJobs.Attention}" />
                            <mi:MaterialIcon DockPanel.Dock="Left" Kind="CloudAlertOutline" Margin="0,0,6,0" Foreground="#F59E0B" IsVisible="{Binding CloudJobs.Attention}" />
                            <TextBlock Classes="small" Text="{Binding CloudJobs.BarText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <TextBlock Classes="muted small" Text="{Binding MirrorText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Grid.Column="4" Classes="muted small" Text="{Binding ModelText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="10,0" IsVisible="{Binding !CanDownloadModel}" />
            </Grid>
        </Border>

        <!-- Sidebar | splitter | content; the sidebar can be hidden and its width is dragged -->
        <Grid x:Name="MainSplit" ColumnDefinitions="250,Auto,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" IsVisible="{Binding SidebarVisible}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="Sidebar" Classes="sidebar" ItemsSource="{Binding SidebarItems}"
                     SelectedItem="{Binding SelectedSidebarItem}" Margin="0,8">
                <ListBox.DataTemplates>
                    <DataTemplate DataType="vm:SidebarHeader">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Classes="heading" Text="{Binding Title}" Margin="0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{Binding AddToolTip}" Click="OnHeaderAdd" IsVisible="{Binding CanAdd}">
                                <mi:MaterialIcon Kind="Plus" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SidebarEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                            <Grid.ContextMenu>
                                <ContextMenu IsVisible="{Binding HasMenu}">
                                    <MenuItem Header="Rename..." Click="OnRenameEntry" IsVisible="{Binding CanRename}" />
                                    <MenuItem Header="Scan again" Click="OnRescanEntry" IsVisible="{Binding CanRescan}" />
                                    <MenuItem Header="Cloud..." Click="OnSourceCloud" IsVisible="{Binding HasCloudButton}" />
                                    <MenuItem Header="Upload here..." Click="OnHereUpload" IsVisible="{Binding CanUpload}" />
                                    <MenuItem Header="Locate folder..." Click="OnLocateEntry" IsVisible="{Binding IsAway}" />
                                    <MenuItem Header="Make read-only..." Click="OnMakeReadOnly" IsVisible="{Binding CanMakeReadOnly}"
                                              ToolTip.Tip="Nothing in it can be deleted, moved or added from MomentFinder, and it cannot be removed from the library, until read-only is turned off with a password" />
                                    <MenuItem Header="Turn read-only off..." Click="OnTurnReadOnlyOff" IsVisible="{Binding IsLocked}"
                                              ToolTip.Tip="Asks for the password; it is read-only again when you turn it on or start MomentFinder again" />
                                    <MenuItem Header="Read-only again" Click="OnTurnReadOnlyOn" IsVisible="{Binding IsTurnedOff}" />
                                    <MenuItem Header="Not read-only any more" Click="OnUnprotect" IsVisible="{Binding IsTurnedOff}" />
                                    <MenuItem Header="{Binding RemoveText}" Click="OnRemoveEntry" IsVisible="{Binding CanRemove}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <mi:MaterialIcon Kind="{Binding Icon}" Margin="0,0,8,0" />
                            <DockPanel Grid.Column="1">
                                <mi:MaterialIcon DockPanel.Dock="Right" Kind="LockOutline" Width="13" Height="13" Margin="4,0,0,0" Opacity="0.6"
                                                 IsVisible="{Binding IsLocked}" ToolTip.Tip="Read-only: right click to turn it off (with the password)" />
                                <mi:MaterialIcon DockPanel.Dock="Right" Kind="LockOpenVariantOutline" Width="13" Height="13" Margin="4,0,0,0" Foreground="#F59E0B"
                                                 IsVisible="{Binding IsTurnedOff}" ToolTip.Tip="Read-only is turned off until you turn it on or start MomentFinder again" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Count}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       IsVisible="{Binding HasCount}" />
                            <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Progress.Text}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" IsVisible="{Binding HasProgress}" />
                            <Button Grid.Column="3" Classes="icon sourcecloud" Click="OnSourceCloud" IsVisible="{Binding HasCloudButton}"
                                    ToolTip.Tip="{Binding CloudTip}" Margin="4,0,0,0">
                                <mi:MaterialIcon Kind="{Binding CloudIcon}" Classes.attention="{Binding CloudAttention}"
                                                 Classes.done="{Binding CloudDone}" Classes.idle="{Binding CloudIdle}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent"
                      IsVisible="{Binding SidebarVisible}" />

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="10,8"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" MaxWidth="800" HorizontalAlignment="Stretch">
                    <Button Grid.Column="0" Classes="toolbar" Command="{Binding ToggleSidebarCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip.Tip="Show / hide the left panel">
                        <mi:MaterialIcon Kind="DockLeft" />
                    </Button>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             PlaceholderText="Search: skier, beach at sunset 2023, video birthday..." KeyDown="OnSearchKeyDown">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Margin="8,0,0,0" Classes="muted" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <!-- When: years, months of the year, or any days -->
                    <!-- A fixed width: the panel below must not move while months are clicked -->
                    <Button Grid.Column="2" Classes="toolbar" Classes.active="{Binding IsDateFiltered}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Width="215" HorizontalContentAlignment="Left" ToolTip.Tip="Only photos and videos from a time span">
                        <DockPanel>
                            <mi:MaterialIcon Kind="CalendarMonthOutline" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DateFilterText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnDateFlyoutOpening">
                                <StackPanel Spacing="8" Width="380">
                                    <TextBlock Classes="heading" Text="YEAR" Margin="0" />
                                    <ItemsControl ItemsSource="{Binding Years}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:DateChoice">
                                                <Button Classes="chip" Classes.selected="{Binding IsSelected}" Margin="0,0,6,6"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PickYearCommand}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Count}" Classes="muted small" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted small" Text="Months are offered when one year is chosen." IsVisible="{Binding HasManyYears}" />
                                    <TextBlock Classes="heading" Text="MONTH" Margin="0" IsVisible="{Binding HasMonths}" />
                                    <ItemsControl ItemsSource="{Binding Months}" IsVisible="{Binding HasMonths}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:DateChoice">
                                                <Button Classes="chip" Classes.selected="{Binding IsSelected}" Margin="0,0,6,6" MinWidth="54"
                                                        IsEnabled="{Binding HasItems}" ToolTip.Tip="{Binding Count}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PickMonthCommand}" CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Label}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="heading" Text="OR ANY DAYS" Margin="0" />
                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <CalendarDatePicker SelectedDate="{Binding DateFrom}" PlaceholderText="From" HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="1" Text="to" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
                                        <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding DateTo}" PlaceholderText="To" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Button Command="{Binding ClearDateCommand}" IsEnabled="{Binding IsDateFiltered}" Margin="0,4,0,0">Any time</Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </Grid>
                    <Button Grid.Column="1" Classes="toolbar" Command="{Binding PlayAllCommand}" Margin="12,0,0,0"
                            ToolTip.Tip="Play all (P): the selection, or the whole result">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="PlayCircleOutline" />
                            <TextBlock Text="Play all" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="toolbar" Command="{Binding ShuffleCommand}" ToolTip.Tip="Shuffle (S)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="ShuffleVariant" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                    <Rectangle Grid.Column="4" Width="1" Height="24" Fill="{DynamicResource AppBorderBrush}" Margin="10,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="toolbar" Command="{Binding AddSelectionToBucketCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="Put the selected photos into a bucket (B), for example for a photo book">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="BasketPlusOutline" />
                                <TextBlock Text="Add to bucket" />
                            </StackPanel>
                        </Button>
                        <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding ActiveBucket}" MinWidth="140"
                                  VerticalAlignment="Center" IsVisible="{Binding HasBuckets}"
                                  ToolTip.Tip="The bucket that Add to bucket and B put the photos into">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="b:Bucket">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <!-- The last one: everything that is set once -->
                    <Button Grid.Column="6" Classes="toolbar" Click="OnOpenSettings" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="Settings: playing, the library in a cloud, the recovery string">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="CogOutline" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1">
            <!-- Until the AI models are installed: what they bring and the download -->
            <Border Classes="card" Margin="12,10,12,0" Padding="14,12" IsVisible="{Binding CanDownloadModel}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="CreationOutline" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,12,0"
                                     Foreground="{DynamicResource SelectionBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AiSetupTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding AiSetupText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloadingModel}" Margin="0,6,0,0" />
                        <TextBlock Classes="muted small" Text="{Binding DownloadText}" IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding DownloadModelCommand}" VerticalAlignment="Top" Margin="16,10,0,0"
                            Classes.accent="{Binding !IsDownloadingModel}" MinWidth="170" HorizontalContentAlignment="Center">
                        <Panel>
                            <TextBlock Text="Download AI models" IsVisible="{Binding !IsDownloadingModel}" />
                            <TextBlock Text="Stop" IsVisible="{Binding IsDownloadingModel}" />
                        </Panel>
                    </Button>
                </Grid>
            </Border>

            <!-- Result line; a bucket gets its own actions -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="12,8,12,4" IsVisible="{Binding !IsPeopleScreen}">
                <TextBlock Classes="muted" Text="{Binding ResultSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding IsPersonScope}">
                    <ToggleButton IsChecked="{Binding ShowPersonFaces}" ToolTip.Tip="The faces and figures recognized as this person: check and correct them">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="FaceRecognition" />
                            <TextBlock Text="Faces" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <!-- How the results look -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding IsGridMode}">
                    <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding GroupBy}" MinWidth="130" VerticalAlignment="Center"
                              ToolTip.Tip="Show the results in groups: by day, month, year, person or folder" />
                    <ToggleButton IsChecked="{Binding GroupTree}" IsVisible="{Binding IsGrouped}" VerticalAlignment="Center"
                                  ToolTip.Tip="The groups as a tree on the left, like folders: the thumbnails show only the chosen one">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="FileTree" />
                            <TextBlock Text="Tree" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Where a clicked photo or video shows -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Classes="segment" Classes.selected="{Binding IsPreviewWindow}" Command="{Binding SetPreviewModeCommand}"
                                CommandParameter="{x:Static vm:PreviewMode.Window}" ToolTip.Tip="A click opens the photo or video full screen">
                            <mi:MaterialIcon Kind="Fullscreen" />
                        </Button>
                        <Button Classes="segment" Classes.selected="{Binding IsPreviewBelow}" Command="{Binding SetPreviewModeCommand}"
                                CommandParameter="{x:Static vm:PreviewMode.Below}" ToolTip.Tip="A click shows the photo or video under the thumbnails">
                            <mi:MaterialIcon Kind="DockBottom" />
                        </Button>
                        <Button Classes="segment" Classes.selected="{Binding IsPreviewRight}" Command="{Binding SetPreviewModeCommand}"
                                CommandParameter="{x:Static vm:PreviewMode.Right}" ToolTip.Tip="A click shows the photo or video right of the thumbnails">
                            <mi:MaterialIcon Kind="DockRight" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <!-- A folder that lives in the cloud: what can be done in it -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding IsCloudScope}">
                    <Button Classes="toolbar" Classes.active="{Binding UploadPanel}" Command="{Binding ToggleUploadCommand}"
                            ToolTip.Tip="Put photos and videos into this folder in the cloud: its folders show as a tree on the left, this computer's files (or another storage's) on the right, and you drag them where they should be">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="CloudUploadOutline" />
                            <TextBlock Text="Upload" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnMoveSelection" ToolTip.Tip="Move the selected photos and videos to another folder in the cloud">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="FolderMoveOutline" />
                            <TextBlock Text="Move" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnDeleteSelection" ToolTip.Tip="Delete the selected photos and videos from the cloud, for good (Delete)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="TrashCanOutline" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBucketScope}">
                    <Button Classes="toolbar" Command="{Binding RemoveSelectionFromBucketCommand}"
                            ToolTip.Tip="Take the selection out of this bucket (Delete); the files stay">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="BasketMinusOutline" />
                            <TextBlock Text="Remove from bucket" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnExportBucket" ToolTip.Tip="Copy the originals to a folder, numbered in the bucket order">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="FolderArrowRightOutline" />
                            <TextBlock Text="Copy to folder..." />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The library of another computer being copied here, or just put in place: in sight wherever the user is -->
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding LibraryCopy.Active}">
                <views:LibraryCopyCard DataContext="{Binding LibraryCopy}" />
            </Border>
            <!-- The family's library is not in the cloud yet and will start from another computer: this one waits for it -->
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding LibraryCopy.FamilyWaiting}">
                <StackPanel Spacing="8">
                    <TextBlock Text="This computer joins the family's library as soon as it is in the cloud" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LibraryCopy.FamilyText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LibraryCopy.FamilyStatus}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding LibraryCopy.FamilyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Command="{Binding LibraryCopy.StartFamilyHereCommand}" HorizontalAlignment="Left" Padding="16,6"
                            ToolTip.Tip="The other computers then join this computer's library, and keep what was named on them">Use this computer's library for the family instead</Button>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding LibraryCopy.RestoredShown}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LibraryCopy.RestoredTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LibraryCopy.RestoredText}" TextWrapping="Wrap" />
                    <Button Command="{Binding LibraryCopy.DismissRestoredCommand}" HorizontalAlignment="Left" Padding="16,6">Got it</Button>
                </StackPanel>
            </Border>

            <!-- An upload or a change in the cloud that runs, or one that did not go: said here too, not only in the status bar -->
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding CloudJobs.Busy}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="CloudSyncOutline" Width="22" Height="22" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CloudJobs.StatusText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding CloudJobs.Percent}" Minimum="0" Maximum="100" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnShowCloudJobs" Margin="12,0,0,0" ToolTip.Tip="How far it is, and a way to stop it">Show</Button>
                </Grid>
            </Border>
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding CloudJobs.Attention}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="CloudAlertOutline" Foreground="#F59E0B" Width="22" Height="22" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding CloudJobs.AttentionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="OnShowCloudJobs" Margin="12,0,0,0">See why</Button>
                </Grid>
            </Border>

            <!-- The folder shown is being read (how far), or is empty (why): right where its photos would be -->
            <Border Classes="card" Margin="12,4,12,6" Padding="14,10" IsVisible="{Binding ScopeBanner}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ScopeBannerText}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ScopeReadingProgress}" Minimum="0" Maximum="100" IsIndeterminate="{Binding !ScopeReadingKnown}"
                                 IsVisible="{Binding ScopeBusy}" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Thumbnails, plain or in groups; only the visible ones exist -->
            <!-- Thumbnails, and the viewer under or right of them; the code arranges the rows and columns by the mode -->
            <!-- The groups' tree (when chosen), and the thumbnails of the chosen place -->
            <Grid x:Name="TreeSplit" Grid.Row="2" ColumnDefinitions="0,Auto,*,Auto" IsVisible="{Binding IsGridMode}">
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowGroupTree}">
                <TreeView x:Name="GroupTreeView" ItemsSource="{Binding GroupRoots}" SelectedItem="{Binding SelectedGroup}" Margin="4,0,0,8">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:GroupNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                        <!-- Something is dragged over the folder: it would go here -->
                        <Style Selector="DockPanel.treerow">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="DockPanel.treerow.droptarget">
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:GroupNode" ItemsSource="{Binding Children}">
                            <DockPanel Classes="treerow" Classes.droptarget="{Binding IsDropTarget}">
                                <!-- A folder that lives in the cloud: what can be done with it -->
                                <DockPanel.ContextMenu>
                                    <ContextMenu IsVisible="{Binding CanUpload}">
                                        <MenuItem Header="Upload here..." Click="OnHereUpload" />
                                        <MenuItem Header="New folder here..." Click="OnTreeNewFolder" />
                                        <MenuItem Header="Move this folder..." Click="OnTreeMoveFolder" IsVisible="{Binding CanChangeFolder}" />
                                        <MenuItem Header="Rename this folder..." Click="OnTreeRenameFolder" IsVisible="{Binding CanChangeFolder}" />
                                        <MenuItem Header="Delete this folder..." Click="OnTreeDeleteFolder" IsVisible="{Binding CanChangeFolder}" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="muted" Margin="10,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" />
                            </DockPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent"
                          IsVisible="{Binding ShowGroupTree}" />
            <Grid x:Name="BrowseArea" Grid.Column="2" RowDefinitions="*,Auto,0" ColumnDefinitions="*,Auto,0">
            <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                          Padding="10,4,10,10">
                <!-- Right click on a photo: what can be done with the selection (the code says which) -->
                <ScrollViewer.ContextMenu>
                    <ContextMenu Opening="OnTileMenuOpening">
                        <MenuItem x:Name="TileMenuMove" Header="Move to another folder..." Click="OnMoveSelection" />
                        <MenuItem x:Name="TileMenuDelete" Header="Delete from the cloud..." Click="OnDeleteSelection" />
                        <MenuItem x:Name="TileMenuWhy" IsEnabled="False" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <!-- The code gives it the list, the layout (TileGridLayout) and the templates of a tile and a group's title -->
                <ItemsRepeater x:Name="Repeater" />
            </ScrollViewer>
            <!-- The panel under the thumbnails: the clicked photo or video -->
            <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Height="6" ResizeDirection="Rows" Background="{DynamicResource AppBorderBrush}"
                          IsVisible="{Binding ShowPreviewPanel}" />
            <Panel x:Name="PreviewHost" Grid.Row="2" Background="Black" IsVisible="{Binding ShowPreviewPanel}">
                <TextBlock Text="Click a photo or video to see it here." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- No inherited DataContext: its bindings are for a PlayerViewModel, set when something is shown -->
                <views:PlayerView x:Name="Preview" IsVisible="False" DataContext="{x:Null}" />
            </Panel>
            </Grid>
            <!-- The upload view: this computer's files (or another storage's), dragged onto a folder on the left -->
            <Border Grid.Column="3" Width="430" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0"
                    IsVisible="{Binding ShowUploadPanel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,2,6,6">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Upload" FontSize="16" FontWeight="SemiBold" />
                            <!-- While something is dragged the same lines say where it would go: nothing below moves -->
                            <TextBlock Classes="small" TextWrapping="Wrap" MinHeight="46" Text="{Binding UploadHint}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleUploadCommand}" VerticalAlignment="Top" ToolTip.Tip="Close the upload view">
                            <mi:MaterialIcon Kind="Close" />
                        </Button>
                    </Grid>
                    <views:FileBrowserPanel x:Name="Browser" DataContext="{Binding Browser}" />
                </DockPanel>
            </Border>
            </Grid>

            <!-- Who is this: everybody without a name, groups of faces and people without a visible face -->
            <DockPanel Grid.Row="2" IsVisible="{Binding IsGroupsMode}" Margin="12,8,12,8">
                <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding People.ClustersSummary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="heading" Text="FACES" IsVisible="{Binding People.HasClusters}" Margin="0" />
                        <!-- Virtualized: a big library has thousands of faces; only those on screen are decoded -->
                        <ItemsRepeater ItemsSource="{Binding People.Clusters}" ElementPrepared="OnCropPrepared" ElementClearing="OnCropClearing">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinItemHeight="196" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate DataType="vm:CropViewModel">
                                    <Border Classes="card" Margin="0,0,10,10">
                                        <StackPanel Spacing="6" Width="140">
                                            <Button Padding="0" Click="OnNameCluster" ToolTip.Tip="Who is it?" Background="Transparent">
                                                <Image Source="{Binding Image}" Width="140" Height="140" Stretch="UniformToFill" />
                                            </Button>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding Caption}" Classes="muted small" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="icon" Click="OnShowClusterPhotos"
                                                        ToolTip.Tip="See the whole photos (with the boxes): when the face alone is too small to tell">
                                                    <mi:MaterialIcon Kind="ImageMultipleOutline" />
                                                </Button>
                                                <Button Grid.Column="2" Classes="icon" Click="OnIgnoreCluster"
                                                        ToolTip.Tip="A stranger: never show this group again">
                                                    <mi:MaterialIcon Kind="EyeOffOutline" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- People without a visible face: by day and place (or video), the ones seen most often first -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0" IsVisible="{Binding People.HasFigures}">
                            <TextBlock Classes="heading" Text="WITHOUT A VISIBLE FACE (HELMETS, FROM BEHIND, FAR AWAY)" Margin="0" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding People.ShowSeenOnce}" IsVisible="{Binding People.HasSeenOnce}" Margin="0,0,16,0"
                                      Content="{Binding People.SeenOnceText}"
                                      ToolTip.Tip="Seen once are mostly strangers passing by; named friends are found there by their clothes anyway" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding People.FigureGroupings}" SelectedItem="{Binding People.FigureGrouping}" MinWidth="160" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{Binding People.FigureSections}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate DataType="vm:FigureSection">
                                    <StackPanel Margin="0,6,0,4">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,8">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Count}" Classes="muted" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <ItemsRepeater ItemsSource="{Binding Cards}" ElementPrepared="OnCropPrepared" ElementClearing="OnCropClearing">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="130" MinItemHeight="262" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate DataType="vm:CropViewModel">
                                                    <Border Classes="card" Margin="0,0,10,10">
                                                        <StackPanel Spacing="6" Width="120">
                                                            <Button Padding="0" Click="OnNameCluster" ToolTip.Tip="Who is it?" Background="Transparent">
                                                                <Image Source="{Binding Image}" Width="120" Height="180" Stretch="Uniform" />
                                                            </Button>
                                                            <TextBlock Text="{Binding Caption}" Classes="muted small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Caption}" />
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <Button Classes="icon" Click="OnShowFigure" HorizontalAlignment="Left"
                                                                        ToolTip.Tip="Play the moment it was found, with the boxes">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <mi:MaterialIcon Kind="PlayCircleOutline" />
                                                                        <TextBlock Text="Play" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Column="1" Classes="icon" Click="OnIgnoreCluster" ToolTip.Tip="A stranger: never show again">
                                                                    <mi:MaterialIcon Kind="EyeOffOutline" />
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Review: one question at a time -->
            <Grid Grid.Row="2" IsVisible="{Binding IsReviewMode}" RowDefinitions="Auto,*,Auto" Margin="20">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding People.ReviewQuestion}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding People.ReviewDetail}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding People.ReviewProgress}" Classes="muted small" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding People.ReviewNote}" Classes="muted small" HorizontalAlignment="Center"
                               IsVisible="{Binding People.ReviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,16" IsVisible="{Binding People.HasReview}">
                    <Image Source="{Binding People.ReviewCrop.Image}" Stretch="Uniform" MaxHeight="320" Margin="10" />
                    <Viewbox Grid.Column="1" Stretch="Uniform" MaxHeight="360" Margin="10">
                        <Panel Width="{Binding People.ContextWidth}" Height="{Binding People.ContextHeight}">
                            <Image Source="{Binding People.ReviewContext}" />
                            <Canvas>
                                <Rectangle Canvas.Left="{Binding People.BoxLeft}" Canvas.Top="{Binding People.BoxTop}"
                                           Width="{Binding People.BoxWidth}" Height="{Binding People.BoxHeight}"
                                           Stroke="#F59E0B" StrokeThickness="3" />
                            </Canvas>
                        </Panel>
                    </Viewbox>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding People.HasReview}">
                    <Button Classes="accent" Command="{Binding People.ReviewYesCommand}" MinWidth="110" HorizontalContentAlignment="Center">Yes (Y)</Button>
                    <Button Command="{Binding People.ReviewNoCommand}" MinWidth="110" HorizontalContentAlignment="Center">No (N)</Button>
                    <Button Click="OnReviewOther" MinWidth="110" HorizontalContentAlignment="Center">Someone else (O)</Button>
                    <Button Command="{Binding People.ReviewSkipCommand}" MinWidth="110" HorizontalContentAlignment="Center">Skip (S)</Button>
                    <Button Click="OnReviewWholePhoto" MinWidth="110" HorizontalContentAlignment="Center"
                            ToolTip.Tip="The whole photo (or the video at that moment) with the boxes, when the crop is too small to tell">Whole photo (W)</Button>
                </StackPanel>
            </Grid>

            <!-- One person's faces and figures -->
            <DockPanel Grid.Row="2" IsVisible="{Binding ShowPersonFaces}" Margin="12,4,12,8">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Classes="muted" Text="{Binding People.PersonSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Click="OnFacesSomeoneElse" ToolTip.Tip="The selected pictures are another person: say who">It is someone else...</Button>
                        <Button Command="{Binding People.RejectSelectedCommand}">Not this person</Button>
                        <Button Command="{Binding People.ConfirmSelectedCommand}">Confirm</Button>
                        <Button Command="{Binding People.SetCoverCommand}">Use as picture</Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{Binding People.PersonCrops}" ElementPrepared="OnCropPrepared" ElementClearing="OnCropClearing">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="122" MinItemHeight="122" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate DataType="vm:CropViewModel">
                                <Border Classes="tile" Classes.selected="{Binding IsSelected}" Margin="0,0,6,6" Tapped="OnCropTapped"
                                        DoubleTapped="OnCropDoubleTapped" ToolTip.Tip="{Binding Caption}">
                                    <Image Source="{Binding Image}" Width="110" Height="110" Stretch="Uniform" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </DockPanel>

            <!-- Empty library -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLibraryEmpty}">
                <mi:MaterialIcon Kind="ImageSearchOutline" Width="56" Height="56" Classes="muted" />
                <TextBlock Text="Add a folder with your photos and videos" FontSize="16" HorizontalAlignment="Center" />
                <Button HorizontalAlignment="Center" Click="OnAddSource">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="FolderPlusOutline" />
                        <TextBlock Text="Add folder..." />
                    </StackPanel>
                </Button>
                <TextBlock Text="or" Classes="muted" HorizontalAlignment="Center" IsVisible="{Binding !LibraryCopy.Active}" />
                <Button HorizontalAlignment="Center" Click="OnCopyLibraryHere" IsVisible="{Binding !LibraryCopy.Active}"
                        ToolTip.Tip="With the recovery string of the computer that has it: its names, people, buckets and folders come here">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="CloudDownloadOutline" />
                        <TextBlock Text="My library is on another computer: use it here too..." />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
    </DockPanel>

    <!-- A window over the library (a folder and the cloud): as tall as its content, never taller than this window -->
    <Border x:Name="Overlay" IsVisible="False" Background="#99000000" Padding="40,32">
        <ContentControl x:Name="OverlayHost" />
    </Border>
    </Panel>
</Window>
