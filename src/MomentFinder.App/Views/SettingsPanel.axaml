<!-- Shown over the main window (see IOverlayPanel) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MomentFinder.App.ViewModels"
             xmlns:v="clr-namespace:MomentFinder.App.Views"
             xmlns:c="clr-namespace:MomentFinder.Cloud;assembly=MomentFinder.Core"
                          x:Class="MomentFinder.App.Views.SettingsPanel"
             x:DataType="vm:MainViewModel"
             MaxWidth="820" VerticalAlignment="Center">
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
            CornerRadius="8" BoxShadow="0 8 32 0 #80000000" ClipToBounds="True">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,0" />
        <!-- Always in sight: what the cloud part is doing, and the way out -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid x:Name="StatusBar" x:DataType="vm:LibraryCloudViewModel" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" MaxLines="4" />
                <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding Busy}" Margin="12,0,0,0">Stop</Button>
                <Button Grid.Column="2" Click="OnClose" Padding="20,6" Margin="12,0,0,0">Close</Button>
            </Grid>
        </Border>
    <ScrollViewer>
        <StackPanel Margin="24,24,24,16" Spacing="16">
            <!-- Viewing -->
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Playing" />
                    <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,Auto" RowSpacing="14">
                        <TextBlock Classes="label" Text="A photo in Play all and Shuffle shows for" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding SlideSeconds}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130" />
                            <TextBlock Classes="label" Text="seconds" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Classes="label" Text="Who is who in a playing video" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <RadioButton GroupName="boxes" IsChecked="{Binding BoxesWhilePlaying}" Content="The boxes follow the people" />
                            <RadioButton GroupName="boxes" IsChecked="{Binding BoxesOnlyPaused}" Content="Boxes only when the video is paused" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="CloudPanel" x:DataType="vm:LibraryCloudViewModel" Spacing="16">
                <!-- The library in a cloud -->
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="The library in a cloud" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="The library is what MomentFinder knows about your photos and videos: these settings, the folders, names and people, buckets, search data and thumbnails. Kept in a cloud, it comes back on any computer from one recovery string. It is stored there as it is; only the access keys of your clouds are encrypted, with a key that is in the recovery string." />
                        <!-- Not connected: the storage -->
                        <StackPanel Spacing="10" IsVisible="{Binding NotConnected}">
                            <!-- A storage the library knows (copied from another computer, or one its folders use): one click -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasKnownClouds}">
                                <Grid ColumnDefinitions="300,*">
                                    <TextBlock Classes="label" Text="A storage the library knows already" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding KnownClouds}" SelectedItem="{Binding KnownCloud}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="c:CloudInfo">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="300,*">
                                    <Button Grid.Column="1" Classes="accent" Command="{Binding ConnectKnownCommand}" IsEnabled="{Binding NotBusy}"
                                            HorizontalAlignment="Left" Padding="16,6">Keep the library there</Button>
                                </Grid>
                                <TextBlock Classes="muted" Text="Or another storage:" Margin="0,8,0,0" />
                            </StackPanel>
                            <v:StorageForm x:Name="LibraryForm" />
                            <Grid ColumnDefinitions="300,*">
                                <Button Grid.Column="1" Classes="accent" Command="{Binding ConnectCommand}" IsEnabled="{Binding NotBusy}"
                                        HorizontalAlignment="Left" Padding="16,6">Connect and keep the library there</Button>
                            </Grid>
                        </StackPanel>

                        <!-- Connected: the state and the way back -->
                        <StackPanel Spacing="10" IsVisible="{Binding Connected}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ConnectedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BackupSummary}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding DisconnectCommand}" IsEnabled="{Binding NotBusy}" VerticalAlignment="Top"
                                        ToolTip.Tip="This computer stops uploading its library. Photos and folders in the cloud, and other computers' backups, stay as they are">Stop backing up the library</Button>
                            </Grid>
                            <WrapPanel>
                                <Button Command="{Binding BackUpNowCommand}" Margin="0,0,8,0">Back up now</Button>
                                <Button Classes="accent" Command="{Binding ShowRecoveryCommand}" IsEnabled="{Binding NotBusy}"
                                        ToolTip.Tip="One string that brings the whole library back on any computer">Show my recovery string</Button>
                            </WrapPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding RecoveryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBox Text="{Binding RecoveryText}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" FontFamily="monospace" FontSize="12" />
                                <WrapPanel>
                                    <Button Click="OnCopyRecovery" Margin="0,0,8,0">Copy</Button>
                                    <Button Click="OnSaveRecovery">Save to a file...</Button>
                                </WrapPanel>
                                <TextBlock Foreground="#F59E0B" TextWrapping="Wrap"
                                           Text="Keep it where you keep passwords, not on this computer only. With it a new computer has your library back. It holds the keys to your storage: anybody who has it gets in." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The library of another computer, copied here -->
                <Border x:Name="CopySection" Classes="card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="Your library on this computer too" />
                        <!-- Being copied, copied or failed: that, in place of the choice -->
                        <Panel IsVisible="{Binding Copy.Active}">
                            <v:LibraryCopyCard DataContext="{Binding Copy}" />
                        </Panel>
                        <StackPanel Spacing="12" IsVisible="{Binding !Copy.Active}">
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="On a second computer, or a new one: copy here the library of a computer that keeps it in a cloud. On that computer, open Settings and Show my recovery string, and paste it below. The copy brings the names and people, buckets, search data and thumbnails. Its folders that are backed up to a cloud are shown here from there." />
                            <TextBox Text="{Binding RestoreText}" PlaceholderText="Paste the recovery string here" TextWrapping="Wrap" MaxHeight="100"
                                     FontFamily="monospace" FontSize="12" />
                            <Button Command="{Binding FindBackupsCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left">Find the library</Button>
                            <StackPanel Spacing="10" IsVisible="{Binding HasFoundBackups}">
                                <ListBox ItemsSource="{Binding FoundBackups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="110">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:BackupChoice">
                                            <TextBlock Text="{Binding Title}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <CheckBox IsChecked="{Binding RestoreThumbnails}"
                                          ToolTip.Tip="Without them the copy is here sooner, and the thumbnails are made again from the photos">With thumbnails</CheckBox>
                                <TextBlock Foreground="#F59E0B" TextWrapping="Wrap" IsVisible="{Binding Replaces}" Text="{Binding ReplacesText}" />
                                <Button Classes="accent" Command="{Binding RestoreLibraryCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left" Padding="16,6">Copy this library here</Button>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="It downloads in the background: you can close Settings and go on working. The main window shows how far it is, and when it is here, a restart opens it." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
    </Border>
</UserControl>
